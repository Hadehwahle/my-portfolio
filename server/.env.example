# ─── Server ───────────────────────────────────────────────────────────────────
PORT=5000

# ─── Email (Gmail SMTP) ───────────────────────────────────────────────────────
# Use a Gmail App Password, NOT your main account password.
# Enable it at: Google Account → Security → 2-Step Verification → App Passwords
EMAIL_USER=your_gmail@gmail.com
EMAIL_PASS=your_16_char_app_password

# The email address that receives contact form submissions (usually same as above)
RECEIVER_EMAIL=your_gmail@gmail.com

# ─── CORS ─────────────────────────────────────────────────────────────────────
# In development: http://localhost:5173
# In production: https://yourdomain.com
# Several origins allowed, comma-separated: https://yourdomain.com,https://www.yourdomain.com
CLIENT_URL=http://localhost:5173

# ─── Hosting ──────────────────────────────────────────────────────────────────
# Set to 1 when deployed behind a proxy (Render, Railway, Nginx) so rate limiting works per visitor
# TRUST_PROXY=1

# Linked from the auto-reply email
LINKEDIN_URL=https://www.linkedin.com/in/adelekepeter/
